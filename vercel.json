{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/palma-fa run build",
  "outputDirectory": "artifacts/palma-fa/dist/public",
  "build": {
    "env": {
      "NODE_ENV": "production",
      "BASE_PATH": "/",
      "PORT": "5173",
      "VITE_PALMA_MOCK_API": "1"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
