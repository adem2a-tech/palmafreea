{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile --prod=false",
  "buildCommand": "pnpm --filter @workspace/palma-fa run build && NODE_ENV=production VERCEL=1 pnpm --filter @workspace/api-server run build && if [ -n \"$DATABASE_URL\" ]; then pnpm --filter @workspace/db run push; fi",
  "outputDirectory": "artifacts/palma-fa/dist/public",
  "build": {
    "env": {
      "BASE_PATH": "/",
      "PORT": "5173"
    }
  },
  "functions": {
    "api/index.mjs": {
      "includeFiles": "api/vercel-bundle/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "routes": [
    { "handle": "filesystem" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
